# NEVER put real credentials in GitHub. Use local .env or GitHub/Streamlit secrets.
BOT_MODE=PAPER
DHAN_LIVE_TRADING_ENABLED=false
BOT_EMERGENCY_STOP=false
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=2
USE_DHAN_DATA=true

# Dhan: enter the manually generated long-valid access credential in DHAN_API_KEY.
# No separate Dhan token, PIN, TOTP, or automatic token generation is used.
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_BASE_URL=https://api.dhan.co
DHAN_SECURITY_IDS_JSON=
BSE_SCRIP_CODES_JSON=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_ADVISORY_MAX_CANDIDATES=3
TWELVEDATA_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BOT_RESEARCH_REFERENCE_CAPITAL=1000
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS=20
MAX_OPEN_POSITIONS=5
MAX_POSITION_EXPOSURE=800
MAX_SECTOR_EXPOSURE=0.30
MAX_CAPITAL_DEPLOYMENT=0.80
CASH_RESERVE_PCT=0.20
MIN_RR=3.0
TREND_BULLISH_THRESHOLD=7.0
TREND_BEARISH_THRESHOLD=4.0
DATA_FRESHNESS_SECONDS=180
SCAN_WORKERS=8
CYCLE_BUDGET_SECONDS=240
SQUARE_OFF_HOUR=15
SQUARE_OFF_MINUTE=20
