# Copy this file to .env and fill in your real values.
# NEVER commit the real .env — it's already in .gitignore.
# In GitHub Actions, set these as repository Secrets instead (Settings > Secrets
# and variables > Actions) and reference them in the workflow YAML — do not
# put real values in this file or in the workflow file itself.

# --- Dhan: authentication (required) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Where the renewed token gets cached locally between runs.
DHAN_TOKEN_FILE=.dhan_access_token.json
# Only override these if Dhan's docs tell you to use a different base URL.
# DHAN_API_BASE_URL=
# DHAN_AUTH_BASE_URL=

# --- Live trading switch: leave this false until Phase 9 says otherwise ---
DHAN_LIVE_TRADING_ENABLED=false

# --- Dhan: instrument IDs (required for live LTP / chart lookups) ---
# JSON object mapping your symbols to Dhan's security IDs, e.g.:
# {"RELIANCE":{"exchange":"NSE_EQ","security_id":2885}}
DHAN_SECURITY_IDS_JSON=
BSE_SCRIP_CODES_JSON=

# --- Dhan: optional tuning (defaults are used if unset) ---
# DHAN_INTRADAY_MIN_INTERVAL_SECONDS=
# DHAN_INTRADAY_RATE_LIMIT_RETRY_SECONDS=
# DHAN_LIVE_SYMBOLS=

# --- Charge-rate overrides (defaults match trading_engine.py's conservative
# estimates — only set these if your actual contract note differs) ---
# DHAN_BROKERAGE_PER_ORDER=20.0
# DHAN_BROKERAGE_PERCENT=0.0003
# DHAN_STT_SELL_PERCENT=0.00025
# DHAN_EXCHANGE_TRANSACTION_PERCENT=0.0000307
# DHAN_SEBI_PER_CRORE=10.0
# DHAN_STAMP_BUY_PERCENT=0.00003
# DHAN_GST_PERCENT=0.18

# --- Optional fallback data provider (used only if Dhan intraday fails) ---
TWELVEDATA_API_KEY=

# --- Telegram (optional — notifications are silently disabled without these) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Research tuning ---
# Reference account equity the dashboard/monitor sizes positions against.
BOT_RESEARCH_REFERENCE_CAPITAL=100000
# Where research_fundamentals.py caches fetched fundamentals between runs.
# FUNDAMENTALS_CACHE_PATH=data/fundamentals_cache.json
